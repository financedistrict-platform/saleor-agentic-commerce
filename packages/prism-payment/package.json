{
  "name": "@financedistrict/saleor-prism-payment",
  "version": "0.2.1",
  "description": "Stablecoin payment handler for Saleor agentic commerce. Enables AI agents to pay with USDC via Finance District Prism and x402/EIP-3009 signed transfers.",
  "author": "Finance District <dev@fd.xyz>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "saleor",
    "saleor-sdk",
    "saleor-payment",
    "prism",
    "x402",
    "stablecoin",
    "usdc",
    "fdusd",
    "eip-3009",
    "crypto-payments",
    "web3-payments",
    "defi",
    "agentic-commerce",
    "ai-commerce",
    "ai-agent",
    "ai-shopping",
    "payment-handler",
    "payment-gateway",
    "finance-district",
    "blockchain-payments",
    "autonomous-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/financedistrict-platform/saleor-agentic-commerce.git",
    "directory": "packages/prism-payment"
  },
  "homepage": "https://github.com/financedistrict-platform/saleor-agentic-commerce#readme",
  "bugs": {
    "url": "https://github.com/financedistrict-platform/saleor-agentic-commerce/issues"
  },
  "dependencies": {},
  "peerDependencies": {
    "@financedistrict/saleor-agentic-commerce-core": "^0.2.0"
  },
  "devDependencies": {
    "@financedistrict/saleor-agentic-commerce-core": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
