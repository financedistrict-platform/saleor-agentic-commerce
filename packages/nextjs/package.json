{
  "name": "@financedistrict/saleor-agentic-commerce-nextjs",
  "version": "0.4.0",
  "description": "Drop-in Next.js route handlers that expose your Saleor storefront to AI shopping agents via UCP and ACP protocols.",
  "author": "Finance District <developers@fd.xyz>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes/*": {
      "types": "./dist/routes/*.d.ts",
      "default": "./dist/routes/*.js"
    },
    "./middleware/*": {
      "types": "./dist/middleware/*.d.ts",
      "default": "./dist/middleware/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "saleor",
    "saleor-sdk",
    "saleor-app",
    "nextjs",
    "next-js",
    "app-router",
    "route-handler",
    "agentic-commerce",
    "ai-commerce",
    "ai-agent",
    "ai-shopping",
    "ucp",
    "acp",
    "universal-commerce-protocol",
    "agentic-commerce-protocol",
    "headless-commerce",
    "storefront",
    "commerce-api",
    "checkout",
    "shopping-agent",
    "autonomous-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/financedistrict-platform/saleor-agentic-commerce.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/financedistrict-platform/saleor-agentic-commerce#readme",
  "bugs": {
    "url": "https://github.com/financedistrict-platform/saleor-agentic-commerce/issues"
  },
  "dependencies": {},
  "peerDependencies": {
    "@financedistrict/saleor-agentic-commerce-core": "^0.4.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@financedistrict/saleor-agentic-commerce-core": "workspace:*",
    "typescript": "^5.3.0"
  }
}
