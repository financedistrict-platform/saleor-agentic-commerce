# App URL — where this App is hosted (no trailing slash)
# Used by the manifest handler to build webhook and extension URLs.
# In development, this is your tunnel URL (e.g., from ngrok or saleor-cli).
APP_URL=https://your-app.example.com

# Secret key used to encrypt App metadata (generate a random 32+ char string)
SECRET_KEY=change-me-to-a-random-secret

# APL (Auth Persistence Layer) — where app auth tokens are stored
# Options: "file" (local dev), "env" (single-tenant), "upstash" (production)
APL=file

# For Upstash APL (production)
# UPSTASH_URL=https://your-db.upstash.io
# UPSTASH_TOKEN=your-upstash-token

# For Env APL (single-tenant production)
# SALEOR_APP_TOKEN=your-app-token
# SALEOR_APP_ID=xyz.fd.saleor-agentic-commerce
# SALEOR_API_URL=https://your-store.saleor.cloud/graphql/

# Restrict which Saleor instances can install this App (comma-separated)
# Leave unset to allow any instance.
# ALLOWED_SALEOR_URLS=https://your-store.saleor.cloud/graphql/
