# syntax=docker/dockerfile:1
#
# Saleor Agentic Commerce App — control plane Saleor App.
#
# Multi-stage Docker build for the @financedistrict/saleor-agentic-commerce-app
# package inside this pnpm monorepo. The build context is the MONOREPO ROOT
# so pnpm workspace metadata (pnpm-workspace.yaml + sibling packages'
# package.json files) is available at install time.
#
# Lives next to the App source so it travels with monorepo layout / build
# pipeline changes. Finance District operates the canonical deployed
# instance via financedistrict-platform/fd-deployments which checks out
# this repo into ./source and points at this Dockerfile.
#
# Build args / env vars:
#   - NEXT_OUTPUT=standalone   (forced inside the builder stage)
#
# Runtime env vars (provided by ECS task definition):
#   - APL                     ("env" in production after install token captured)
#   - SALEOR_API_URL          (Saleor instance GraphQL endpoint)
#   - ALLOWED_SALEOR_URLS     (comma-separated, normally same as SALEOR_API_URL)
#   - APP_URL                 (public URL of THIS service, used in manifest)
#   - SALEOR_APP_TOKEN        (from EnvAPL — captured after first install)
#   - SALEOR_APP_ID           (from EnvAPL — captured after first install)
#   - PORT                    (default 3001)

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# Pin pnpm to v9 (matches ci.yml + lockfileVersion 9.0). Without a pin, corepack
# pulls the current `latest` pnpm (now v11), which requires `node:sqlite` — a
# builtin only present on Node >=22.5, so it crashes on this node:20 base with
# ERR_UNKNOWN_BUILTIN_MODULE during `pnpm install`.
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# ----------------------------------------------------------------------------
# deps — install workspace dependencies for the app's transitive set
# ----------------------------------------------------------------------------
FROM base AS deps
WORKDIR /repo

# Bring in the workspace metadata so pnpm understands the monorepo shape.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/saleor-agentic-commerce-app/package.json apps/saleor-agentic-commerce-app/package.json
# The other workspace packages aren't dependencies of the app, but pnpm
# wants to see their package.json files to resolve the workspace graph
# under --frozen-lockfile.
COPY packages/core/package.json packages/core/package.json
COPY packages/nextjs/package.json packages/nextjs/package.json
COPY packages/prism-payment/package.json packages/prism-payment/package.json

RUN pnpm install --frozen-lockfile --prefer-offline \
        --filter @financedistrict/saleor-agentic-commerce-app...

# ----------------------------------------------------------------------------
# builder — produce .next/standalone for the runner stage
# ----------------------------------------------------------------------------
FROM base AS builder
WORKDIR /repo

# Inherit installed node_modules from deps
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/saleor-agentic-commerce-app/node_modules ./apps/saleor-agentic-commerce-app/node_modules

# Copy the rest of the monorepo source.
COPY . .

ENV NEXT_OUTPUT=standalone

# `next build` runs the App's static analysis pass which imports route modules
# and exercises any code that runs at module load time. The Saleor App SDK
# uses optional env vars at runtime; nothing critical is read at module load,
# so no build-time placeholder env vars are required for THIS app (unlike the
# storefront's agentic-commerce wrapper which we hit earlier).
RUN pnpm --filter @financedistrict/saleor-agentic-commerce-app build

# ----------------------------------------------------------------------------
# runner — minimal production image
# ----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

RUN addgroup --system --gid 1001 nodejs
RUN adduser  --system --uid 1001 nextjs

# Copy the standalone output. With outputFileTracingRoot set to the monorepo
# root, .next/standalone contains the full hoisted node_modules graph at the
# repo root, plus the app's compiled server under apps/saleor-agentic-commerce-app/.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/saleor-agentic-commerce-app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/saleor-agentic-commerce-app/.next/static ./apps/saleor-agentic-commerce-app/.next/static
COPY --from=builder --chown=nextjs:nodejs /repo/apps/saleor-agentic-commerce-app/public ./apps/saleor-agentic-commerce-app/public

USER nextjs

# server.js is generated by Next.js standalone build; with the monorepo
# tracing root, it lives under apps/saleor-agentic-commerce-app/server.js.
CMD ["node", "apps/saleor-agentic-commerce-app/server.js"]
